@model IEnumerable<CRM.Entities.Teklif>

@{
    ViewData["Title"] = "Teklif Listesi";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-file-earmark-text"></i> Teklif Listesi</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Teklif/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Teklif Ekle</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Teklif No / Başlık</th>
                        <th>Toplam Tutar</th>
                        <th>Geçerlilik Tarihi</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TeklifNo</td>
                                <td>@item.ToplamTutar ₺</td>
                                <td>@(item.GecerlilikTarihi.HasValue ? item.GecerlilikTarihi.Value.ToShortDateString() : "-")</td>
                                <td>
                                    <span class="badge bg-info text-dark">@item.TeklifDurumu</span>
                                </td>
                                <td class="text-end">
                                    <a href="/Teklif/Edit/@item.TeklifId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/Teklif/Delete/@item.TeklifId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kayıtlı teklif bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>