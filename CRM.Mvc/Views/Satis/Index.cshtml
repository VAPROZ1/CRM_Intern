@model IEnumerable<CRM.Entities.Satis>

@{
    ViewData["Title"] = "Satış Listesi";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-cash-stack"></i> Satış Listesi</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Satis/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Satış Ekle</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Satış ID</th>
                        <th>Toplam Tutar</th>
                        <th>Satış Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.SatisId</td>
                                <td>@item.ToplamTutar ₺</td>
                                <td>@item.SatisTarihi.ToShortDateString()</td>
                                <td class="text-end">
                                    <a href="/Satis/Edit/@item.SatisId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/Satis/Delete/@item.SatisId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Henüz kayıtlı satış bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>