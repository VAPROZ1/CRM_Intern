@model IEnumerable<CRM.Entities.Urun>

@{
    ViewData["Title"] = "Ürün Listesi";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-box-seam"></i> Ürün Listesi</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Urun/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Ürün Ekle</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Ürün Adı</th>
                        <th>Fiyat</th>
                        <th>Stok Adedi</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.UrunAdi</td>
                                <td>@item.BirimFiyat ₺</td>
                                <td>%@item.KdvOrani</td> <!-- Stok yerine KdvOrani yaptık -->
                                <td>
                                    @if (item.AktifMi)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a href="/Urun/Edit/@item.UrunId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/Urun/Delete/@item.UrunId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kayıtlı ürün bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>