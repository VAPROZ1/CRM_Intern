@model IEnumerable<CRM.Entities.Kategori>

@{
    ViewData["Title"] = "Kategori Listesi";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-tags"></i> Kategori Listesi</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Kategori/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Kategori Ekle</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Kategori Adı</th>
                        <th>Açıklama</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.KategoriAdi</td>
                                <td>@(string.IsNullOrEmpty(item.Aciklama) ? "-" : item.Aciklama)</td>
                                <td class="text-end">
                                    <a href="/Kategori/Edit/@item.KategoriId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/Kategori/Delete/@item.KategoriId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">Henüz kayıtlı kategori bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>