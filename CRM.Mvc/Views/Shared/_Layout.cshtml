<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRM Yönetim Paneli</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/Home/Index"><i class="bi bi-speedometer2"></i> CRM Paneli</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 flex-wrap">
                        <li class="nav-item"><a class="nav-link text-light" href="/Musteri">Müşteriler</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Firma">Firmalar</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Urun">Ürünler</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Firsat">Fırsatlar</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/DestekTalebi">Destek</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Aktivite">Aktiviteler</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Teklif">Teklifler</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Satis">Satışlar</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Kategori">Kategoriler</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Not">Notlar</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Kullanici">Kullanıcılar</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4 py-3 text-center">
        <div class="container">
            &copy; 2026 - CRM Yönetim Paneli - Tüm Hakları Saklıdır.
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>