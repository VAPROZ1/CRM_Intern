@model IEnumerable<CRM.Entities.Not>

@{
    ViewData["Title"] = "Notlar Listesi";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-journal-text"></i> Notlar Listesi</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Not/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Not Ekle</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Başlık / Konu</th>
                        <th>İçerik</th>
                        <th>Tarih</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NotBasligi</td>
                                <td>@item.NotIcerigi</td>
                                <td>@item.OlusturmaTarihi.ToShortDateString()</td>
                                <td class="text-end">
                                    <a href="/Not/Edit/@item.NotId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/Not/Delete/@item.NotId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Henüz kayıtlı not bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>