@model IEnumerable<CRM.Entities.DestekTalebi>

@{
    ViewData["Title"] = "Destek Talepleri";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-headset"></i> Destek Talepleri</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/DestekTalebi/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Destek Talebi</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Konu / Başlık</th>
                        <th>Öncelik</th>
                        <th>Durum</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Konu</td>
                                <td>
                                    <span class="badge bg-warning text-dark">@item.Oncelik</span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark">@item.Durum</span>
                                </td>
                                <td>@item.OlusturmaTarihi.ToShortDateString()</td>
                                <td class="text-end">
                                    <a href="/DestekTalebi/Edit/@item.TalepId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/DestekTalebi/Delete/@item.TalepId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kayıtlı destek talebi bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>