@model IEnumerable<CRM.Entities.Firsat>

@{
    ViewData["Title"] = "Fırsat Listesi";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-graph-up-arrow"></i> Fırsat Listesi</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Firsat/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Fırsat Ekle</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Fırsat Adı</th>
                        <th>Tahmini Tutar</th>
                        <th>Aşama</th>
                        <th>Kapanış Tarihi</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.FirsatBasligi</td>
                                <td>@item.TahminiTutar ₺</td>
                                <td>
                                    <span class="badge bg-info text-dark">@item.FirsatDurumu</span>
                                </td>
                                <td>@(item.BeklenenKapanisTarihi.HasValue ? item.BeklenenKapanisTarihi.Value.ToShortDateString() : "-")</td>
                                <td class="text-end">
                                    <a href="/Firsat/Edit/@item.FirsatId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/Firsat/Delete/@item.FirsatId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kayıtlı fırsat bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>