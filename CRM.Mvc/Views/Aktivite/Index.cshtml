@model IEnumerable<CRM.Entities.Aktivite>

@{
    ViewData["Title"] = "Aktivite Listesi";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-calendar-check"></i> Aktivite Listesi</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Aktivite/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Aktivite Ekle</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Konu / Başlık</th>
                        <th>Tür</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Konu</td>
                                <td>
                                    <span class="badge bg-secondary">@item.AktiviteTipi</span>
                                </td>
                                <td>@item.AktiviteTarihi.ToShortDateString()</td>
                                <td>
                                    <span class="badge bg-info text-dark">@item.AktiviteDurumu</span>
                                </td>
                                <td class="text-end">
                                    <a href="/Aktivite/Edit/@item.AktiviteId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/Aktivite/Delete/@item.AktiviteId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kayıtlı aktivite bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>