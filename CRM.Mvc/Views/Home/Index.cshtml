@{
    ViewData["Title"] = "CRM Dashboard";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
                <div class="container-fluid py-3">
                    <h1 class="display-5 fw-bold text-dark"><i class="bi bi-speedometer2 text-primary"></i> CRM Yönetim Paneline Hoş Geldiniz</h1>
                    <p class="col-md-8 fs-4 text-muted">Staj projesi kapsamında geliştirilen API destekli akıllı müşteri ilişkileri yönetim sistemi.</p>
                    <hr class="my-4">
                    <p>Üst menüyü kullanarak Müşteriler, Firmalar, Ürünler, Fırsatlar, Teklifler ve Destek Talepleri arasında hızlıca geçiş yapabilirsiniz.</p>
                    <a class="btn btn-primary btn-lg" href="/Musteri" role="button"><i class="bi bi-people"></i> Müşteri Yönetimine Git</a>
                </div>
            </div>
        </div>
    </div>

    <!-- İstatistik Kartları -->
    <div class="row text-center">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-people-fill"></i> Toplam Müşteri</h5>
                    <h3>@ViewBag.MusteriCount</h3>
                    <a href="/Musteri" class="text-white text-decoration-none small">Detaylar &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-building"></i> Toplam Firma</h5>
                    <h3>@ViewBag.FirmaCount</h3>
                    <a href="/Firma" class="text-white text-decoration-none small">Detaylar &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning shadow-dark">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-box-seam"></i> Toplam Ürün</h5>
                    <h3>@ViewBag.UrunCount</h3>
                    <a href="/Urun" class="text-white text-decoration-none small">Detaylar &rarr;</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-danger shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-graph-up-arrow"></i> Aktif Fırsatlar</h5>
                    <h3>@ViewBag.FirsatCount</h3>
                    <a href="/Firsat" class="text-white text-decoration-none small">Detaylar &rarr;</a>
                </div>
            </div>
        </div>
    </div>
</div>