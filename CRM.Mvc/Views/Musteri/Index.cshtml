@model IEnumerable<CRM.Entities.Musteri>

@{
    ViewData["Title"] = "Müşteri Listesi";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2><i class="bi bi-people-fill"></i> Müşteri Listesi</h2>
        </div>
        <div class="col-md-6 text-end">
            <a href="/Musteri/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Müşteri Ekle</a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Adı Soyadı</th>
                        <th>Telefon</th>
                        <th>E-posta</th>
                        <th>Durumu</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Ad @item.Soyad</td>
                                <td>@item.Telefon</td>
                                <td>@item.Eposta</td>
                                <td>
                                    <span class="badge bg-success">@item.MusteriDurumu</span>
                                </td>
                                <td class="text-end">
                                    <a href="/Musteri/Edit/@item.MusteriId" class="btn btn-sm btn-warning">Düzenle</a>
                                    <a href="/Musteri/Delete/@item.MusteriId" class="btn btn-sm btn-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Henüz kayıtlı müşteri bulunmamaktadır.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>